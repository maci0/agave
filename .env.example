# Copy to .env and fill in. Never commit .env (gitignored).
# Prefer env vars over --api-key so secrets stay out of process listings.
# Generate a key:  openssl rand -hex 32
#
# Empty values are treated as unset by the process (same as omitting the
# variable). Docker Compose still requires a non-empty AGAVE_API_KEY (`:?`)
# because the image binds 0.0.0.0.

# Required for Docker/serve binds on 0.0.0.0 (non-loopback).
AGAVE_API_KEY=

# Listen port inside the container / process (default 49453).
# Keep host publish (-p) and HEALTHCHECK aligned with this value.
AGAVE_PORT=49453

# docker compose: host address for published ports (default loopback-only).
# Use 0.0.0.0 only when remote clients must reach the server.
# AGAVE_HOST_BIND=127.0.0.1

# Optional bind override when not using the Docker image ENTRYPOINT.
# AGAVE_HOST=127.0.0.1

# docker compose: host directory mounted read-only at /models
AGAVE_MODELS_DIR=./models

# docker compose: persistent cache (conversations, Vulkan pipeline cache, Hub pulls).
# Default is a named volume `agave-cache`. Set to a host path to bind-mount instead.
# Either way this is the only copy of the conversation store: back it up to
# another filesystem with scripts/conv-store-backup.sh (docs/DURABILITY.md).
# AGAVE_CACHE_DIR=./.agave-cache

# docker compose: model path as seen inside the container
AGAVE_MODEL=/models/model.gguf

# Optional: Hugging Face Hub API base (src/pull.zig), for a mirror or an
# air-gapped gateway. Must be an http(s) URL; default is https://huggingface.co.
# HF_ENDPOINT=

# Optional: Hugging Face Hub downloads (src/pull.zig)
# docker compose forwards HF_TOKEN and HF_ENDPOINT into the container
# (empty = unset).
# Do not set HF_HOME / XDG_CACHE_HOME for compose — those are host paths;
# Hub blobs persist in the agave-cache volume at /home/agave/.cache.
# HF_TOKEN=
# HF_HOME=
# XDG_CACHE_HOME=

# Optional: disable colored terminal output (https://no-color.org)
# NO_COLOR=1

# Optional: dump intermediate vision encoder buffers for debugging
# Only 1 enables, 0 disables; any other value warns and stays off.
# AGAVE_VISION_DEBUG=1

# Optional: dump DFlash2 speculation-round traces (1 enables, 0 disables)
# AGAVE_DF2_DEBUG=1
