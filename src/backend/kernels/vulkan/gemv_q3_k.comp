// GEMV for Q3_K quantized weights.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer W { uint w_raw[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };
layout(push_constant) uniform Params { uint n; uint k; };

shared float shared_sums[32];  // 256/min_subgroup_size(8) = 32 max subgroups

// Q3_K super-block: 110 bytes = 32B hmask + 64B qs + 12B scales + 2B f16 d
// 256 values per super-block, 16 groups of 16 elements
// 3-bit: 2 bits from qs + 1 bit from hmask
// Dequant: val = d * scale * ((q_lo | (q_hi << 2)) - 4)

uint readByte(uint byte_off) {
    return (w_raw[byte_off / 4] >> ((byte_off % 4) * 8)) & 0xFF;
}

float readF16(uint byte_off) {
    uint word = w_raw[byte_off / 4];
    uint shift = (byte_off % 4) * 8;
    uint bits = (word >> shift) & 0xFFFF;
    if (shift > 16) {
        bits = (word >> shift) | (w_raw[byte_off / 4 + 1] << (32 - shift));
        bits &= 0xFFFF;
    }
    return unpackHalf2x16(bits).x;
}

void main() {
    uint row = gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint tg_size = gl_WorkGroupSize.x;
    if (row >= n) return;

    uint nb = (k + 255) / 256;
    float sum = 0.0;

    for (uint b = tid; b < nb; b += tg_size) {
        uint bk = b * 256;

        // Sparse skip: check if all 256 input values are near-zero
        float bmax = 0.0;
        uint check_end = min(256u, k - bk);
        for (uint i = 0; i < check_end; i += 4) {
            vec4 v = abs(vec4(x[bk+i], x[bk+i+1], x[bk+i+2], x[bk+i+3]));
            bmax = max(bmax, max(max(v.x, v.y), max(v.z, v.w)));
        }
        if (bmax < 0.005) continue;

        uint bp = row * nb * 110 + b * 110;
        float d = readF16(bp + 108);

        for (uint g = 0; g < 16; g++) {
            uint base = bk + g * 16;
            if (base >= k) break;

            // Extract 6-bit scale: low 4 bits from bytes 0-7, high 2 bits from bytes 8-11
            uint scale_byte = readByte(bp + 96 + (g < 8 ? g : g - 8));
            uint lo4 = g < 8 ? (scale_byte & 0xFu) : (scale_byte >> 4);
            uint hi_byte = readByte(bp + 96 + 8 + g / 4);
            uint hi2 = (hi_byte >> ((g % 4) * 2)) & 0x3u;
            float d_sc = d * float(int(lo4 | (hi2 << 4)) - 32);

            for (uint l = 0; l < 16 && base + l < k; l++) {
                uint flat_idx = g * 16 + l;
                uint qs_byte_idx = flat_idx / 4;
                uint qs_bit_shift = (flat_idx % 4) * 2;
                uint q_lo = (readByte(bp + 32 + qs_byte_idx) >> qs_bit_shift) & 0x3;

                uint hm_byte_idx = flat_idx % 32;
                uint hm_bit = flat_idx / 32;
                uint q_hi = (readByte(bp + hm_byte_idx) >> hm_bit) & 1;

                int q3 = int(q_lo | (q_hi << 2)) - 4;
                sum += x[base + l] * d_sc * float(q3);
            }
        }
    }

    sum = subgroupAdd(sum);
    uint sg_id = gl_SubgroupID;
    uint sg_lane = gl_SubgroupInvocationID;
    if (sg_lane == 0) shared_sums[sg_id] = sum;
    barrier();
    uint num_sg = (tg_size + gl_SubgroupSize - 1) / gl_SubgroupSize;
    if (tid < num_sg) sum = shared_sums[tid]; else sum = 0.0;
    if (tid < gl_SubgroupSize) {
        sum = subgroupAdd(sum);
        if (tid == 0) y[row] = sum;
    }
}
