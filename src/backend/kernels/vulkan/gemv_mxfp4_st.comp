// GEMV for MXFP4 E2M1 weights with per-group U8 scales.
// gs and scale_fmt are push constants:
//   gs         = 16 (NVIDIA MXFP4) or 32 (MLX community MoE experts)
//   scale_fmt  = 0 FP8 E4M3, 1 E8M0 (2^(byte-127))
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer W { uint w_packed[]; };
layout(set = 0, binding = 2) readonly buffer S { uint s_packed[]; };
layout(set = 0, binding = 3) writeonly buffer Y { float y[]; };
layout(push_constant) uniform Params { uint n; uint k; uint gs; uint scale_fmt; };

float mxfp4_lut(uint nibble) {
    float t[16] = float[16](0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
                            -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0);
    return t[nibble & 0xFu];
}

float fp8e4m3(uint val) {
    uint s = (val >> 7) & 1u;
    uint e = (val >> 3) & 0xFu;
    uint m = val & 0x7u;
    if (e == 0u) {
        if (m == 0u) return 0.0;
        float fv = float(m) / 8.0 * exp2(-6.0);
        return s == 1u ? -fv : fv;
    }
    if (e == 15u && m == 7u) return 0.0;
    float fv = (1.0 + float(m) / 8.0) * exp2(float(e) - 7.0);
    return s == 1u ? -fv : fv;
}

float e8m0_to_f32(uint val) {
    if (val == 0u) return 0.0;
    return uintBitsToFloat(val << 23);
}

shared float partial[256];

void main() {
    uint row = gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= n) return;

    uint group_size = max(gs, 8u);
    uint gpr = (k + group_size - 1u) / group_size;
    uint wpg = group_size / 8u;
    uint wpr = gpr * wpg;
    uint row_w = row * wpr;

    float sum = 0.0;
    for (uint g = tid; g < gpr; g += 256u) {
        uint s_idx = row * gpr + g;
        uint s_word = s_packed[s_idx / 4u];
        uint s_byte = (s_word >> ((s_idx % 4u) * 8u)) & 0xFFu;
        float sc = (scale_fmt == 1u) ? e8m0_to_f32(s_byte) : fp8e4m3(s_byte);

        uint xo = g * group_size;
        uint wg = row_w + g * wpg;
        float gdot = 0.0;
        for (uint w = 0u; w < wpg && xo + w * 8u < k; w++) {
            uint word = w_packed[wg + w];
            uint xi = xo + w * 8u;
            uint rem = min(8u, k - xi);
            for (uint i = 0u; i < rem; i++) {
                gdot += mxfp4_lut((word >> (i * 4u)) & 0xFu) * x[xi + i];
            }
        }
        sum += sc * gdot;
    }

    partial[tid] = sum;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) partial[tid] += partial[tid + s];
        barrier();
    }
    if (tid == 0u) y[row] = partial[0];
}
