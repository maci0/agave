// HQQ INT4 GEMV: y[row] = dot(dequant(W[row, :]), x)
//
// HQQ format:
//   w_q   : uint8, shape [n_out, k_in/2] — low nibble = even k, high nibble = odd k
//   scale : bf16,  shape [n_out, k_in/group_size]
//   zero  : bf16,  shape [n_out, k_in/group_size]
//
// Dequant: w = (nibble - zero) * scale
//
// One workgroup per output row; 256 threads per workgroup.
// Each thread accumulates over its share of k, then a two-level subgroup
// reduction writes the final scalar to y[row].

#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

// binding 0: x          — f32 activations [k]
// binding 1: w_q        — packed uint8 nibbles, stored as uint32 words [n * k/2 / 4]
// binding 2: scale      — bf16 packed two-per-u32, shape [n * k/group_size]
// binding 3: zero       — bf16 packed two-per-u32, shape [n * k/group_size]
// binding 4: y          — f32 output [n]
layout(set = 0, binding = 0) readonly  buffer X  { float  x_data[];     };
layout(set = 0, binding = 1) readonly  buffer WQ { uint   wq_data[];    };
layout(set = 0, binding = 2) readonly  buffer SC { uint   scale_data[]; };
layout(set = 0, binding = 3) readonly  buffer ZR { uint   zero_data[];  };
layout(set = 0, binding = 4) writeonly buffer Y  { float  y_data[];     };

layout(push_constant) uniform Params {
    uint n;          // output dimension (number of rows)
    uint k;          // input  dimension
    uint group_size; // quantization group size (typically 64)
};

shared float shared_sums[8]; // one slot per subgroup (256 threads / 32 lanes = 8)

// Decode bf16 (u16) to float32 by placing the 16 bits in the upper half of a u32.
// bf16 == float32 with the low 16 mantissa bits truncated.
float bf16ToFloat(uint bits16) {
    return uintBitsToFloat(bits16 << 16);
}

void main() {
    uint row     = gl_WorkGroupID.x;
    uint tid     = gl_LocalInvocationID.x;
    uint tg_size = gl_WorkGroupSize.x; // 256

    if (row >= n) return;

    // Number of quantization groups along k for this row.
    uint n_groups = (k + group_size - 1u) / group_size;

    // Byte offset in w_q to the start of this row (k/2 bytes per row).
    uint row_byte_off = row * (k / 2u);

    float sum = 0.0;

    for (uint ki = tid; ki < k; ki += tg_size) {
        float xv = x_data[ki];
        // Sparse skip: skip near-zero activations to save multiply-adds.
        if (abs(xv) < 0.005) continue;

        // Locate the packed byte for column ki.
        // Two nibbles per byte: even ki -> low nibble, odd ki -> high nibble.
        uint byte_idx = row_byte_off + ki / 2u;
        uint word     = wq_data[byte_idx / 4u];
        uint byte_val = (word >> ((byte_idx % 4u) * 8u)) & 0xFFu;
        float nibble  = (ki % 2u == 0u)
                        ? float(byte_val & 0xFu)
                        : float(byte_val >> 4u);

        // Fetch bf16 scale and zero for this group.
        // Both are stored packed two-per-u32 at logical index [row * n_groups + g].
        uint  g      = ki / group_size;
        uint  sq_idx = row * n_groups + g;

        uint sc_word  = scale_data[sq_idx / 2u];
        uint sc_bits  = (sq_idx % 2u == 0u) ? (sc_word & 0xFFFFu) : (sc_word >> 16u);
        float scale   = bf16ToFloat(sc_bits);

        uint zr_word  = zero_data[sq_idx / 2u];
        uint zr_bits  = (sq_idx % 2u == 0u) ? (zr_word & 0xFFFFu) : (zr_word >> 16u);
        float zero    = bf16ToFloat(zr_bits);

        sum += (nibble - zero) * scale * xv;
    }

    // Two-level reduction: subgroup add first, then workgroup reduction via shared mem.
    sum = subgroupAdd(sum);
    uint sg_lane = gl_SubgroupInvocationID;
    uint sg_id   = gl_SubgroupID;
    uint num_sg  = (tg_size + gl_SubgroupSize - 1u) / gl_SubgroupSize;
    if (sg_lane == 0u) shared_sums[sg_id] = sum;
    barrier();
    if (tid < num_sg) sum = shared_sums[tid]; else sum = 0.0;
    if (tid < gl_SubgroupSize) {
        sum = subgroupAdd(sum);
        if (tid == 0u) y_data[row] = sum;
    }
}
