// L2 normalization.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer X { float x[]; };
layout(push_constant) uniform Params { uint n; float eps; };

shared float shared_sums[32];  // 256/min_subgroup_size(8) = 32 max subgroups

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tg_size = gl_WorkGroupSize.x;

    // Sum of squares
    float ss = 0.0;
    for (uint i = tid; i < n; i += tg_size) {
        ss += x[i] * x[i];
    }

    ss = subgroupAdd(ss);
    uint sg_id = gl_SubgroupID;
    uint sg_lane = gl_SubgroupInvocationID;
    if (sg_lane == 0) shared_sums[sg_id] = ss;
    barrier();
    uint num_sg = (tg_size + gl_SubgroupSize - 1) / gl_SubgroupSize;
    // Fold every subgroup partial, not just the first gl_SubgroupSize of them.
    // num_sg is 256/gl_SubgroupSize (32 on an 8-lane subgroup), so a single
    // subgroupAdd summed 8 of the 32 partials and dropped the rest, making
    // inv_rms too small and every normalized element too large.
    for (uint stride = num_sg / 2; stride > 0u; stride >>= 1u) {
        if (tid < stride) shared_sums[tid] += shared_sums[tid + stride];
        barrier();
    }
    if ((num_sg & 1u) != 0u && tid == 0) shared_sums[0] += shared_sums[num_sg - 1];
    barrier();

    // Normalize in-place
    float inv = inversesqrt(shared_sums[0] + eps);
    for (uint i = tid; i < n; i += tg_size) {
        x[i] *= inv;
    }
}
