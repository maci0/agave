// Softmax normalization.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Data { float data_buf[]; };
layout(push_constant) uniform Params { uint n; };

shared float shared_vals[32];  // 256/min_subgroup_size(8) = 32 max subgroups

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tg_size = gl_WorkGroupSize.x;

    // Pass 1: find max
    float mx = -1.0 / 0.0;  // -inf
    for (uint i = tid; i < n; i += tg_size) {
        mx = max(mx, data_buf[i]);
    }
    mx = subgroupMax(mx);
    uint sg_id = gl_SubgroupID;
    uint sg_lane = gl_SubgroupInvocationID;
    if (sg_lane == 0) shared_vals[sg_id] = mx;
    barrier();
    uint num_sg = (tg_size + gl_SubgroupSize - 1) / gl_SubgroupSize;
    // Fold every subgroup partial, not just the first gl_SubgroupSize of them
    // (num_sg is up to 32 on an 8-lane subgroup, so 24 partial maxima were
    // dropped and the shift used was too small).
    for (uint stride = num_sg / 2; stride > 0u; stride >>= 1u) {
        if (tid < stride) shared_vals[tid] = max(shared_vals[tid], shared_vals[tid + stride]);
        barrier();
    }
    if ((num_sg & 1u) != 0u && tid == 0)
        shared_vals[0] = max(shared_vals[0], shared_vals[num_sg - 1]);
    barrier();
    float max_val = shared_vals[0];
    // Every thread has read the reduced value before any subgroup reuses the
    // scratch slot for the next reduction (write-after-read hazard).
    barrier();

    // Pass 2: exp(x - max) and sum
    float local_sum = 0.0;
    for (uint i = tid; i < n; i += tg_size) {
        float v = exp(data_buf[i] - max_val);
        data_buf[i] = v;
        local_sum += v;
    }
    local_sum = subgroupAdd(local_sum);
    if (sg_lane == 0) shared_vals[sg_id] = local_sum;
    barrier();
    // Fold every subgroup partial, not just the first gl_SubgroupSize of them
    // (num_sg is up to 32 on an 8-lane subgroup, so 24 sums were dropped).
    for (uint stride = num_sg / 2; stride > 0u; stride >>= 1u) {
        if (tid < stride) shared_vals[tid] += shared_vals[tid + stride];
        barrier();
    }
    if ((num_sg & 1u) != 0u && tid == 0) shared_vals[0] += shared_vals[num_sg - 1];
    barrier();
    float inv_sum = 1.0 / shared_vals[0];

    // Pass 3: normalize
    for (uint i = tid; i < n; i += tg_size) {
        data_buf[i] *= inv_sum;
    }
}
