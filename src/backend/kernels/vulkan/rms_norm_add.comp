// RMS normalization with residual addition.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer A { float a[]; };      // FFN output (read-only)
layout(set = 0, binding = 1) readonly buffer Wt { float wt[]; };    // norm weights
layout(set = 0, binding = 2) buffer B { float b[]; };               // residual stream (accumulated)
layout(push_constant) uniform Params { uint n; float eps; };
shared float shared_sums[8];
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tg_size = gl_WorkGroupSize.x;
    // Phase 1: sum of squares of a
    float ss = 0.0;
    for (uint i = tid; i < n; i += tg_size) ss += a[i] * a[i];
    ss = subgroupAdd(ss);
    uint sg_id = gl_SubgroupID;
    uint sg_lane = gl_SubgroupInvocationID;
    if (sg_lane == 0) shared_sums[sg_id] = ss;
    barrier();
    uint num_sg = (tg_size + gl_SubgroupSize - 1) / gl_SubgroupSize;
    if (tid < num_sg) ss = shared_sums[tid]; else ss = 0.0;
    if (tid < gl_SubgroupSize) {
        ss = subgroupAdd(ss);
        if (tid == 0) shared_sums[0] = ss;
    }
    barrier();
    // Phase 2: b[i] += norm(a[i]) * wt[i]
    float inv_rms = inversesqrt(shared_sums[0] / float(n) + eps);
    for (uint i = tid; i < n; i += tg_size)
        b[i] += a[i] * wt[i] * inv_rms;
}
