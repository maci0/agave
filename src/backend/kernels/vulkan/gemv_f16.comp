// GEMV for f16 weights.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer W { uint w_raw[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };
layout(push_constant) uniform Params { uint n; uint k; };

shared float shared_sums[32];  // 256/min_subgroup_size(8) = 32 max subgroups

void main() {
    uint row = gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint tg_size = gl_WorkGroupSize.x;
    if (row >= n) return;

    float sum = 0.0;
    uint row_byte_off = row * k * 2;

    for (uint j = tid; j < k; j += tg_size) {
        uint byte_off = row_byte_off + j * 2;
        uint word_idx = byte_off / 4;
        uint byte_in_word = byte_off % 4;

        uint raw = w_raw[word_idx];
        uint bits;
        if (byte_in_word <= 2) {
            bits = (raw >> (byte_in_word * 8)) & 0xFFFF;
        } else {
            uint next_raw = w_raw[word_idx + 1];
            bits = ((raw >> 24) & 0xFF) | ((next_raw & 0xFF) << 8);
        }
        float w_val = unpackHalf2x16(bits).x;
        sum += w_val * x[j];
    }

    sum = subgroupAdd(sum);
    uint sg_id = gl_SubgroupID;
    uint sg_lane = gl_SubgroupInvocationID;
    if (sg_lane == 0) shared_sums[sg_id] = sum;
    barrier();
    uint num_sg = (tg_size + gl_SubgroupSize - 1) / gl_SubgroupSize;
    if (tid < num_sg) sum = shared_sums[tid]; else sum = 0.0;
    // Fold every subgroup partial, not just the first gl_SubgroupSize of
    // them: num_sg is up to 32 on an 8-lane subgroup, so 24 of the 32
    // partial sums were dropped and the result was far too small.
    for (uint stride = num_sg / 2; stride > 0u; stride >>= 1u) {
        if (tid < stride) shared_sums[tid] += shared_sums[tid + stride];
        barrier();
    }
    if ((num_sg & 1u) != 0u && tid == 0) shared_sums[0] += shared_sums[num_sg - 1];
    barrier();
    if (tid == 0) y[row] = shared_sums[0];
}
