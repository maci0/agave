# Scheduled backup of the web-UI conversation store, the only state Agave
# owns that cannot be regenerated. From the repository root, install the
# script and both unit files, then:
#
#   install -Dm0755 scripts/conv-store-backup.sh \
#     /usr/local/bin/conv-store-backup.sh
#   install -Dm0644 scripts/systemd/agave-conv-store-backup.service \
#     /etc/systemd/system/agave-conv-store-backup.service
#   install -Dm0644 scripts/systemd/agave-conv-store-backup.timer \
#     /etc/systemd/system/agave-conv-store-backup.timer
#   systemctl daemon-reload
#   systemctl enable --now agave-conv-store-backup.timer
#
# ExecStart below names /usr/local/bin/conv-store-backup.sh, and only the
# container image puts the script there. Copying the two unit files without
# it gives every run 203/EXEC, which reads as a stopped backup rather than a
# missing install.
#
# Edit the two settings marked below before enabling. Runbook:
# docs/DURABILITY.md.
#
# User= and ReadWritePaths= name an account and a directory the host does not
# have until they are created, and a missing one fails the unit at start rather
# than at backup time: User=agave gives 217/USER, and a missing
# /var/backups/agave gives 200/CHDIR from ReadWritePaths. On a host that does not
# already run the server under a dedicated account:
#
#   useradd --system --home-dir /var/lib/agave --shell /usr/sbin/nologin agave
#   install -d -o agave -g agave -m 0700 /var/backups/agave
#
# ProtectHome=read-only leaves the store under that account's home readable,
# which is all `backup` needs. Put /var/backups/agave on a different filesystem
# from the store's directory; the script refuses to run otherwise (see below).
[Unit]
Description=Back up the Agave conversation store
After=local-fs.target
# A run that keeps failing is stopped rather than retried for an hour: the
# alert belongs to the operator, and a destination that stays unwritable is
# not fixed by a retry.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
# The account the server runs as: it has to read the store, and the backup
# directory has to be writable by it.
User=agave
# Must be a different filesystem than the conversation store's directory, or
# `backup` refuses to run. `df -P` decides.
Environment=AGAVE_BACKUP_DIR=/var/backups/agave
ExecStart=/usr/local/bin/conv-store-backup.sh backup
# Freshness and loadability of the newest copy. A nonzero exit from either
# command is the alert.
ExecStartPost=/usr/local/bin/conv-store-backup.sh check
Restart=on-failure
RestartSec=5min

# The script reads the store and writes the backup tier. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/agave
# The unit runs cp, awk, stat, and sync. It needs no devices beyond /dev/null
# and /dev/urandom, no kernel or hostname surface, and no way to add itself to
# a cgroup or load a module.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
# Backups are chat history: keep the copy and the umask that made it
# owner-only even if the operator's shell login sets a permissive umask.
UMask=0077
# No sockets: the script never talks to a network. AF_UNIX is left available
# because bash and coreutils open a notify socket in some libc paths.
RestrictAddressFamilies=AF_UNIX
# The Bash syntax tree is not JIT-compiled, so W^X holds.
MemoryDenyWriteExecute=true
