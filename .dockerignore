# Build artifacts
.zig-cache/
zig-out/
zig-out-linux/

# Model weights at repo root (bind-mounted at runtime).
# MUST be /models/, a bare models/ also excludes src/models/ (architecture code).
/models/
*.gguf
*.safetensors

# Python / research / top-level WASM demo (not needed in image).
# Anchor with / so src/web and similar paths stay in the build context.
.venv/
/research/
/tests/
/web/
__pycache__/

# Review / planning outputs (not needed in image)
/outputs/
.planning/
.scratch/
progress.md
# The runtime stage copies scripts/conv-store-backup.sh out of the build
# context, so that one file must survive. `/scripts/*` rather than
# `/scripts/`: a directory-level exclude prunes the tree before any
# `!` re-include can match.
/scripts/*
!/scripts/conv-store-backup.sh
/graphify-out/
.pi-subagents/
.review-loop.lock

# IDE / tools
.opencode/
.vscode/
.idea/
.claude/
.playwright-mcp/

# Editor temporary files / local backups (keep out of build context)
*.swp
*.swo
*~
*.bak
*.bak_*
*.orig

# Compiled artifacts (from local builds outside Zig)
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Kernel compilation temps
test_*.s
test_*.ll
test_*.spv

# Test images
test_*.png

# OS junk
.DS_Store
Thumbs.db

# Git / GitHub
.git/
.github/
.gitignore

# Docs (not needed in the image). Keep LICENSE in context: the runtime stage
# copies it to /usr/share/doc/agave/copyright (GPL-3.0-or-later).
docs/
*.md
# ...except the notices for the third-party code in the embedded web bundle,
# which the runtime stage copies to /usr/share/doc/agave as well.
!THIRD_PARTY_NOTICES.md

# Log files
*.log

# Debug tensor dumps
*.bin
vision_ref_dumps/

# Environment / secrets
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Local orchestration (not needed in image build context)
docker-compose*.yml
compose*.yml

# Local tooling / experiments (not needed in image)
/tools/

# JS deps (bun install output, 100+ MB, never read by the Zig build)
/node_modules/
/.web-ts-out/

# Host-path cache (AGAVE_CACHE_DIR). Holds the plaintext conversation store
# and Hub blobs; gitignored, but the Docker build context is a separate
# filter, so it would otherwise be sent and copied into the build stage.
/.agave-cache/

# Stray files
pelorus-*.yaml
*.dSYM
